{
  "name": "@dagim_codes/sheriff",
  "version": "0.1.5",
  "description": "Test coverage workflows for Claude Code and Codex: discover, audit, generate, and sync tests.",
  "keywords": [
    "testing",
    "coverage",
    "claude-code",
    "codex",
    "agent-skills",
    "ai",
    "automation"
  ],
  "license": "MIT",
  "author": "dagim_codes",
  "bin": {
    "sheriff": "./bin/install.js"
  },
  "scripts": {
    "build:hooks": "node scripts/build-hooks.js",
    "pretest": "npm run build:hooks",
    "test": "node --test tests/*.test.js",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:report": "node scripts/benchmark-report.js",
    "test:live:codex": "node tests/live/run.js codex",
    "test:live:claude": "node tests/live/run.js claude",
    "prepack": "npm run build:hooks",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "commands/",
    "agents/",
    "integrations/",
    "hooks/dist/",
    "sheriff/",
    "workflows/",
    "scripts/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dagim-shimelis/sheriff.git"
  },
  "homepage": "https://github.com/dagim-shimelis/sheriff#readme",
  "bugs": {
    "url": "https://github.com/dagim-shimelis/sheriff/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
